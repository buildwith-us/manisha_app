# ─────────────────────────────────────────────────────────────
# Manisha Fashions — Backend environment
# PRD 8.5 / 8.11: this file is a TEMPLATE. Copy to .env and fill in.
# .env itself is gitignored and must never be committed.
# ─────────────────────────────────────────────────────────────

NODE_ENV=development
PORT=4000
API_PREFIX=/api/v1

# Lets the fake OTP and the in-process store run under NODE_ENV=production.
# Needed on the hosted build only while OTP_PROVIDER=fake, because production
# refuses both by default. While this is "true", ANYONE who knows a phone number
# can sign in as that user with OTP_FAKE_CODE — including the admin number.
# Set it back to false the moment the real SMS provider is wired.
UNSAFE_DEV_MODE=false

# ── Database (PRD 8.2 — MongoDB Atlas) ──
MONGODB_URI=mongodb://127.0.0.1:27017/manisha_fashions

# ── Redis (PRD 2 / 8.11 — OTP store + rate-limit counters) ──
# Leave blank in local dev to fall back to an in-memory store.
REDIS_URL=redis://127.0.0.1:6379

# ── JWT (PRD 8.7) ──
# Must be a long random value. Rotate immediately if ever exposed.
JWT_ACCESS_SECRET=change-me-to-a-64-char-random-string
JWT_REFRESH_SECRET=change-me-to-a-different-64-char-random-string
JWT_ACCESS_TTL=30m
# Default idle period before OTP is required again (PRD 4.1) — admin-configurable.
JWT_REFRESH_TTL_DAYS=90

# ── OTP (PRD 8.7) ──
# Provider: fake | console | msg91
#   fake    — no SMS. OTP_FAKE_CODE is issued and accepted for every number.
#             Temporary stand-in until the real SMS module is chosen.
#   console — a random code, printed to the server log.
#   msg91   — real SMS. The only option valid in production.
OTP_PROVIDER=fake
OTP_FAKE_CODE=123456
OTP_LENGTH=6
OTP_TTL_SECONDS=600
OTP_MAX_SEND_PER_HOUR=5
OTP_MAX_VERIFY_ATTEMPTS=5
OTP_LOCKOUT_SECONDS=900
MSG91_AUTH_KEY=
MSG91_SENDER_ID=
MSG91_TEMPLATE_ID=

# ── Cloudinary (PRD 8.3) ──
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
CLOUDINARY_FOLDER=manisha-fashions/products

# ── Razorpay (PRD 4.4) ──
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=

# ── Push (PRD 4.6) ──
# Firebase/FCM has been removed. Notifications are persisted and shown in the
# app's notification list; OS-level banners resume once a replacement provider
# is implemented behind deliver() in services/notification.service.ts.

# ── Commerce settings (PRD 6 — open items, admin-tunable) ──
# COD shipping charge in paise (5000 = ₹50.00). Confirm amount with client.
COD_SHIPPING_CHARGE=5000
PREPAID_SHIPPING_CHARGE=0
CURRENCY=INR

# ── Security (PRD 8.11) ──
CORS_ORIGINS=http://localhost:8081,http://localhost:19006
RATE_LIMIT_GENERAL_PER_MIN=100
TRUST_PROXY=1

# ── Seed script ──
SEED_ADMIN_PHONE=+919345548984

# ── Admin access ──
# Comma-separated numbers that are always signed in as admin, whichever tab the
# login screen was on. This is why there is no separate admin login: the owner
# signs in through the normal retail form and lands in the admin panel.
ADMIN_PHONES=+919345548984
